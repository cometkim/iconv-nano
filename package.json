{
  "name": "iconv-nano",
  "version": "0.0.0",
  "description": "Tree-shakable ESM iconv-lite for encoding and decoding",
  "keywords": [
    "encoding",
    "iconv",
    "icu",
    "unicode",
    "utf-8"
  ],
  "license": "MIT",
  "author": "Jeremy Nguyen <hi@jeremy.ng>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "generate-encodings": "node ./scripts/generate-encodings"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^26.6.3",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "publint": "^0.3.24",
    "rolldown": "^1.2.12",
    "strip-json-comments": "^5.0.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.10.0",
      "onFail": "download"
    }
  }
}
